# ── 모두 선택 사항입니다. 웹 화면의 설정에서 API 키와 모델을 넣어도 됩니다. ──

# 서버 공용 OpenRouter 키 (없으면 사용자가 웹에서 자기 키를 넣거나, 둘 다 없으면 모의 모드)
OPENROUTER_API_KEY=

# 인증키: 이 값을 입력한 사람만 위 공용 키를 쓸 수 있어요. 나머지는 자기 키를 넣거나 모의 모드로 써요.
# 비워 두면 누구나 공용 키를 쓰니, 공개 주소라면 꼭 설정하세요. 실제 값은 코드나 저장소에 적지 말고 Vercel 환경변수에만 넣으세요.
MEETING_PASSCODE=

# 에이전트 개인 메모 암호화용 비밀값 (아무 긴 문자열)
STATE_SECRET=change-me-to-a-long-random-string

# 고를 수 있는 모델 회사 (OpenRouter 모델 ID 앞부분)
ALLOWED_VENDORS=openai,anthropic,google,x-ai,upstage

# 에이전트별 기본 모델 (웹에서 바꾸지 않았을 때 쓰는 값)
MODEL_MODERATOR=google/gemini-3-flash-preview
MODEL_CRITIC=anthropic/claude-sonnet-5
MODEL_STRATEGIST=openai/gpt-5.5
MODEL_READER=upstage/solar-pro4
MODEL_METHOD=google/gemini-3-flash-preview
MODEL_POLICY=x-ai/grok-4.20

# 공용 키로 할 수 있는 최대 턴 수 (기본 12). 내 API 키를 쓰는 사람에게는 적용되지 않아요.
SHARED_MAX_TURNS=12

# 공용 키로 부를 때 쓰는 가벼운 모델 (비우면 아래 기본값). 내 API 키를 쓰는 사람에게는 위 MODEL_* 이 기본이에요.
SHARED_MODEL_MODERATOR=google/gemini-3-flash-preview
SHARED_MODEL_CRITIC=anthropic/claude-haiku-4.5
SHARED_MODEL_STRATEGIST=openai/gpt-5-mini
SHARED_MODEL_READER=upstage/solar-pro4
SHARED_MODEL_METHOD=google/gemini-3-flash-preview
SHARED_MODEL_POLICY=x-ai/grok-4.1-fast
